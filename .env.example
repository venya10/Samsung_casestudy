# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# Free key: console at https://aistudio.google.com/apikey (Google AI Studio),
# no billing required for the free tier.
#
# Without this key the assistant runs a deterministic fallback that answers the
# brief's five questions from the same tables and states clearly that it is doing
# so, so a demo never dead-ends.

GEMINI_API_KEY=...
