# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# Free key: console at https://aistudio.google.com/apikey (Google AI Studio),
# no billing required for the free tier.
#
# Without this key the assistant runs a deterministic fallback that answers the
# brief's five questions from the same tables and states clearly that it is doing
# so, so a demo never dead-ends.

GEMINI_API_KEY=...

# Gates the Data page's "Replace the dataset" upload button. Unset (default):
# the button is disabled with a note, so a public deploy can't have its live
# dataset replaced by anyone with the URL. Set to any passphrase to enable it
# -- whoever has this value can upload a new dataset and trigger a full
# rebuild.
UPLOAD_PASSCODE=...
